# ==========================================================================
# Mohana Priya — Portfolio
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret to Git.
# ==========================================================================

# ---------------------------------------------------------------------------
# ADMIN AUTHENTICATION (single administrator, env-driven, no database)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com

# Admin password hash (bcrypt). Generate one with:
#   node scripts/hash-password.mjs <your-password>
# IMPORTANT: Next.js expands "$VAR" in .env values, which would corrupt the
# "$2b$..." bcrypt prefix. Escape every "$" as "\$" (the loader unescapes it):
ADMIN_PASSWORD_HASH="\$2b\$10\$EXAMPLE_REPLACE_WITH_REAL_BCRYPT_HASH"

# Random secret used to sign/verify JWT session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Session lifetime in seconds (default 12 hours).
SESSION_MAX_AGE=43200

# ---------------------------------------------------------------------------
# GITHUB CONTENT STORAGE (GitHub acts as the versioned content repository)
# ---------------------------------------------------------------------------
GITHUB_OWNER=your-github-username
GITHUB_REPOSITORY=your-portfolio-repo-name
GITHUB_BRANCH=main
# Fine-grained PAT with "Contents: Read and write" on this single repository only.
GITHUB_TOKEN=github_pat_xxx_replace_me

# When true (default), admin saves are also written to the local content/
# directory so the dev server reflects changes immediately without a rebuild.
CONTENT_WRITE_LOCAL=true

# ---------------------------------------------------------------------------
# CONTACT / EMAIL (optional — if absent, the contact form falls back to mailto)
# ---------------------------------------------------------------------------
# Provider currently supports: resend (https://resend.com)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx_replace_me
CONTACT_EMAIL=mohanabharani480@gmail.com

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
# Canonical public URL of the deployed site (used for SEO/sitemap).
NEXT_PUBLIC_SITE_URL=